<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DDay3</RootNamespace>
    <AssemblyName>DDay3</AssemblyName>
    <ApplicationIcon>Assets\DDay3.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>3.5.4.0</AssemblyVersion>
    <FileVersion>3.5.4.0</FileVersion>
    <Version>3.5.4</Version>
    <Company>MathTime</Company>
    <Product>D-Day 3</Product>
    <Copyright>Copyright © 2026 MathTime</Copyright>
    <Configurations>Release;Debug</Configurations>
    <!-- Future roadmap module. Ordinary Debug/Release builds contain no OAuth UI or implementation. -->
    <EnableGoogleOAuth Condition="'$(EnableGoogleOAuth)'==''">false</EnableGoogleOAuth>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>$(DefineConstants);TRACE_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)'=='Release'">
    <Compile Remove="Diagnostics\DeveloperTraceLog.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(EnableGoogleOAuth)'=='true'">
    <DefineConstants>$(DefineConstants);GOOGLE_OAUTH</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableGoogleOAuth)'!='true'">
    <Compile Remove="Services\Google*.cs;Models\GoogleCalendarModels.cs;Views\Google*.xaml.cs" />
    <Page Remove="Views\Google*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="4.3.1" />
    <PackageReference Include="NodaTime" Version="3.2.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />

    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Xml.Linq" />
    <!-- WPF markup compilation resolves WebResourceAttribute from System.Web. -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\bin\**\*;tests\obj\**\*" />
    <Resource Include="Assets\DDay3.png" />
    <None Remove="Build\GoogleOAuthClient.json" />
    <EmbeddedResource Include="Build\GoogleOAuthClient.json" Condition="'$(EnableGoogleOAuth)'=='true' and Exists('Build\GoogleOAuthClient.json')"
                      LogicalName="DDay3.GoogleOAuthClient.json" />
  </ItemGroup>
</Project>
