<Window x:Class="DDay3.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DDay3.Views"
        Title="D-Day 3 정보" Width="430" Height="355"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Border CornerRadius="23" Background="{DynamicResource WindowVeilBrush}"
            BorderBrush="#C8FFFFFF" BorderThickness="1" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <views:AboutContent/>
            <Button Grid.Row="1" Content="닫기" Width="92" HorizontalAlignment="Center" Click="Close_OnClick"/>
        </Grid>
    </Border>
</Window>
