<Window x:Class="DDay3.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D-Day 3 정보" Width="430" Height="355"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Border CornerRadius="23" Background="{DynamicResource WindowVeilBrush}"
            BorderBrush="#C8FFFFFF" BorderThickness="1" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center">
                <Image Source="/Assets/DDay3.png" Width="86" Height="86" Margin="0,0,0,7"/>
                <TextBlock Text="D-Day 3" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Version 3.1.4" Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,3,0,12"/>
                <TextBlock Text="일정·시계·음력·달력을 나만의 글꼴과 유리 패널로 표시하는 Windows용 D-Day 위젯입니다."
                           TextWrapping="Wrap" TextAlignment="Center" Width="350"/>
                <TextBlock Text="© 2026 MathTime · Freeware" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <Button Content="https://mathtime.kr/?page=dday" Click="Website_OnClick" Margin="0,7,0,0"/>
            </StackPanel>
            <Button Grid.Row="1" Content="닫기" Width="92" HorizontalAlignment="Center" Click="Close_OnClick"/>
        </Grid>
    </Border>
</Window>
