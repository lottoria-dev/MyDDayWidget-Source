<Window x:Class="DDay3.Views.IcsSubscriptionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="캘린더 URL 구독" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowVeilBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="iCal 주소로 구독" FontSize="19" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="1" Text="Google Calendar의 설정 → 해당 캘린더 → 캘린더 통합에서 iCal 주소를 복사하세요. 공개·비공개 iCal 주소를 지원합니다." TextWrapping="Wrap" Margin="0,8,0,12"/>
  <StackPanel Grid.Row="2"><TextBlock Text="캘린더 이름 (선택)"/><TextBox x:Name="NameInput" MaxLength="160" Margin="0,4,0,10"/></StackPanel>
  <StackPanel Grid.Row="3"><TextBlock Text="iCal 주소"/><PasswordBox x:Name="UrlInput" MaxLength="4096" Margin="0,4,0,6" Padding="8"/></StackPanel>
  <TextBlock Grid.Row="4" Text="주소는 Ctrl+V로 붙여넣으세요. 비공개 주소는 접근 열쇠이므로 화면에 숨기고 암호화해 저장합니다. 웹페이지 주소는 사용할 수 없습니다." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>
  <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="갱신 주기" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <ComboBox x:Name="IntervalInput" Grid.Column="1" SelectedIndex="2">
    <ComboBoxItem Content="수동" Tag="0"/><ComboBoxItem Content="15분" Tag="15"/><ComboBoxItem Content="30분" Tag="30"/>
    <ComboBoxItem Content="1시간" Tag="60"/><ComboBoxItem Content="3시간" Tag="180"/><ComboBoxItem Content="6시간" Tag="360"/><ComboBoxItem Content="하루" Tag="1440"/>
   </ComboBox>
  </Grid>
  <TextBlock Grid.Row="6" x:Name="StatusText" TextWrapping="Wrap" Margin="0,12" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="취소" IsCancel="True"/><Button x:Name="RegisterButton" Content="등록" Click="Register_OnClick" IsDefault="True"/>
  </StackPanel>
 </Grid>
</Window>
