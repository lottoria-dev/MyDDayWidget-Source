<Window x:Class="DDay3.Views.IcsCalendarWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="캘린더 파일·URL 관리" Width="510" Height="480" MinWidth="460" MinHeight="400" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowVeilBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
 <Window.Resources>
  <Style x:Key="CalendarActionButton" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3,0"/>
  </Style>
 </Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="캘린더 파일·URL" FontSize="19" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="1" Text=".ics 파일을 가져오거나 iCal URL을 구독하세요. 제목과 날짜만 사용합니다. 체크한 URL은 지정한 주기로 갱신하고 파일은 직접 교체합니다." TextWrapping="Wrap" Margin="0,8,0,12"/>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#EFFFFFFF" Padding="6">
   <ItemsControl x:Name="CalendarList">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border CornerRadius="10" Padding="8,9" Margin="0,0,0,5" Background="#70FFFFFF">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0" HorizontalContentAlignment="Stretch" ToolTip="달력에 표시" AutomationProperties.Name="이 캘린더를 달력에 표시">
         <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
        </CheckBox>
        <TextBlock Text="{Binding ImportedText}" FontSize="11" Margin="21,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <ComboBox ItemsSource="{Binding RefreshChoices}" DisplayMemberPath="Title" SelectedValue="{Binding RefreshMinutes, Mode=TwoWay}" SelectedValuePath="Minutes" Width="120" HorizontalAlignment="Left" Margin="21,6,0,0" ToolTip="URL 자동 갱신 주기 · 적용하면 저장됩니다">
         <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsSubscription}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
        </ComboBox>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
        <Button Style="{StaticResource CalendarActionButton}" Click="Refresh_OnClick" ToolTip="이 캘린더 갱신" AutomationProperties.Name="이 캘린더 갱신">
         <Path Width="16" Height="16" Data="M 13,5 A 6,6 0 1 0 14,9 M 13,1 L 13,5 L 9,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Button>
        <Button Style="{StaticResource CalendarActionButton}" Click="Remove_OnClick" ToolTip="이 캘린더 삭제" AutomationProperties.Name="이 캘린더 삭제">
         <Path Width="16" Height="16" Data="M 2,4 L 14,4 M 6,4 L 6,1 L 10,1 L 10,4 M 4,4 L 5,15 L 11,15 L 12,4 M 7,7 L 7,12 M 9,7 L 9,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Button>
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <TextBlock Grid.Row="3" x:Name="StatusText" TextWrapping="Wrap" Margin="0,10" AutomationProperties.LiveSetting="Polite"/>
  <WrapPanel Grid.Row="4" x:Name="Actions" HorizontalAlignment="Right">
   <Button Content="파일 가져오기…" Click="Import_OnClick"/>
   <Button Content="URL 구독…" Click="Subscribe_OnClick"/>
   <Button Content="닫기" IsCancel="True"/>
   <Button Content="적용" Click="Save_OnClick" IsDefault="True"/>
  </WrapPanel>
 </Grid>
</Window>
